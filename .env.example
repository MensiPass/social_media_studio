# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Database ---
# These values must match what's in docker-compose.yml
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=social_studio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection string FastAPI/SQLAlchemy will use
DATABASE_URL=postgresql+psycopg://studio_user:changeme_local_dev_only@localhost:5432/social_studio

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram (added on Day 7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LinkedIn (added on Day 8) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# --- Crash recovery (added Day 10) ---
STUCK_SLOT_THRESHOLD_SECONDS=120